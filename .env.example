# JURIVA Environment Variables Example
# Copy this file to .env.local and fill in your API key

# Groq API Key (Recommended for high performance)
GROQ_API_KEY=your_groq_api_key_here

# Alternatively, generic AI API Key (Gemini or OpenAI-compatible)
# AI_API_KEY=your_api_key_here

# Optional Configurations (defaults shown)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
